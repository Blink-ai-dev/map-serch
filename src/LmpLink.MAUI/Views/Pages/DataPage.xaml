<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LmpLink.MAUI.ViewModels"
             xmlns:controls="clr-namespace:LmpLink.MAUI.Views.Controls"
             x:Class="LmpLink.MAUI.Views.Pages.DataPage"
             x:DataType="vm:DataViewModel"
             Title="데이터"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundDeepNavy}">

    <Grid RowDefinitions="Auto,*">
        <controls:AppTabMenu Grid.Row="0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Title -->
            <Label 
                Text="📥 데이터 관리"
                Style="{StaticResource Heading1}"
                FontSize="{DynamicResource TitleFontSize}"
                TextColor="{StaticResource PrimaryCTA}" />

            <!-- Excel Export -->
            <Frame BackgroundColor="{StaticResource SurfaceDarkGray}" Padding="20" CornerRadius="12">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="📤 엑셀 내보내기"
                        Style="{StaticResource Heading3}"
                        TextColor="{StaticResource TextWhite}" />
                    <Label 
                        Text="현재 데이터를 엑셀 파일로 저장합니다."
                        Style="{StaticResource Body2}"
                        TextColor="{StaticResource TextLightGray}" />
                    <Button 
                        Text="엑셀로 내보내기"
                        Command="{Binding ExportToExcelCommand}"
                        BackgroundColor="{StaticResource AccentSecondary}"
                        TextColor="{StaticResource TextWhite}"
                        CornerRadius="8"
                        Padding="15,10"
                        FontSize="{DynamicResource ButtonFontSize}"
                        HeightRequest="{DynamicResource ButtonHeight}" />
                    
                    <!-- Export Status -->
                    <Label 
                        Text="{Binding LastExportPath, StringFormat='마지막 내보내기: {0}'}"
                        Style="{StaticResource Caption}"
                        TextColor="{StaticResource TextLightGray}"
                        IsVisible="{Binding LastExportPath, Converter={StaticResource IsNotNullConverter}}"
                        Margin="0,10,0,0" />
                    <Label 
                        Text="{Binding ExportedCount, StringFormat='내보낸 데이터: {0}명'}"
                        Style="{StaticResource Caption}"
                        TextColor="{StaticResource PrimaryCTA}"
                        IsVisible="{Binding ExportedCount, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Excel Import -->
            <Frame BackgroundColor="{StaticResource SurfaceDarkGray}" Padding="20" CornerRadius="12">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="📥 엑셀 불러오기"
                        Style="{StaticResource Heading3}"
                        TextColor="{StaticResource TextWhite}" />
                    <Label 
                        Text="엑셀 파일에서 데이터를 가져옵니다."
                        Style="{StaticResource Body2}"
                        TextColor="{StaticResource TextLightGray}" />
                    <Button 
                        Text="엑셀에서 불러오기"
                        Command="{Binding ImportFromExcelCommand}"
                        BackgroundColor="{StaticResource AccentSecondary}"
                        TextColor="{StaticResource TextWhite}"
                        CornerRadius="8"
                        Padding="15,10"
                        FontSize="{DynamicResource ButtonFontSize}"
                        HeightRequest="{DynamicResource ButtonHeight}" />
                    
                    <!-- Import Status -->
                    <Label 
                        Text="{Binding LastImportPath, StringFormat='마지막 불러오기: {0}'}"
                        Style="{StaticResource Caption}"
                        TextColor="{StaticResource TextLightGray}"
                        IsVisible="{Binding LastImportPath, Converter={StaticResource IsNotNullConverter}}"
                        Margin="0,10,0,0" />
                    <Label 
                        Text="{Binding ImportedCount, StringFormat='불러온 데이터: {0}명'}"
                        Style="{StaticResource Caption}"
                        TextColor="{StaticResource PrimaryCTA}"
                        IsVisible="{Binding ImportedCount, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Backup Settings -->
            <Frame BackgroundColor="{StaticResource SurfaceDarkGray}" Padding="20" CornerRadius="12">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="🔄 백업 설정"
                        Style="{StaticResource Heading3}"
                        TextColor="{StaticResource TextWhite}" />
                    <Label 
                        Text="🚧 개발 중 - 자동 백업 기능은 추후 구현 예정입니다."
                        Style="{StaticResource Body2}"
                        TextColor="{StaticResource TextLightGray}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Current Data Save -->
            <Frame BackgroundColor="{StaticResource SurfaceDarkGray}" Padding="20" CornerRadius="12">
                <VerticalStackLayout Spacing="10">
                    <Label 
                        Text="💾 현재 데이터 저장"
                        Style="{StaticResource Heading3}"
                        TextColor="{StaticResource TextWhite}" />
                    <Label 
                        Text="현재 데이터를 Supabase에 저장합니다."
                        Style="{StaticResource Body2}"
                        TextColor="{StaticResource TextLightGray}" />
                    <Button 
                        Text="현재 데이터 저장"
                        Command="{Binding SaveCurrentDataCommand}"
                        BackgroundColor="{StaticResource PrimaryCTA}"
                        TextColor="{StaticResource TextWhite}"
                        CornerRadius="8"
                        Padding="15,10"
                        FontSize="{DynamicResource ButtonFontSize}"
                        HeightRequest="{DynamicResource ButtonHeight}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{StaticResource PrimaryCTA}"
                WidthRequest="40"
                HeightRequest="40"
                HorizontalOptions="Center"
                Margin="20" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

