<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LmpLink.MAUI.ViewModels"
             xmlns:models="clr-namespace:LmpLink.MAUI.Models"
             xmlns:controls="clr-namespace:LmpLink.MAUI.Views.Controls"
             x:Class="LmpLink.MAUI.Views.Pages.ManagementPage"
             x:DataType="vm:ManagementViewModel"
             Title="관리"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource BackgroundDeepNavy}">

    <Grid RowDefinitions="Auto,*">
        <controls:AppTabMenu Grid.Row="0" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Padding="20">
        
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
            <Label 
                Grid.Column="0"
                Text="이용자/활동지원사 관리"
                Style="{StaticResource Heading1}"
                FontSize="{DynamicResource TitleFontSize}"
                TextColor="{StaticResource PrimaryCTA}"
                VerticalOptions="Center" />
            
            <Button 
                Grid.Column="1"
                Text="+ 신규 등록"
                Command="{Binding CreatePersonCommand}"
                BackgroundColor="{StaticResource PrimaryCTA}"
                TextColor="{StaticResource TextWhite}"
                Padding="20,10"
                CornerRadius="8"
                FontSize="{DynamicResource ButtonFontSize}"
                HeightRequest="{DynamicResource ButtonHeight}" />
        </Grid>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,15">
            
            <!-- Type Filter: All -->
            <Button 
                Grid.Column="0"
                Text="전체"
                Command="{Binding ApplyFilterCommand}"
                CommandParameter="all"
                BackgroundColor="{StaticResource SurfaceDarkGray}"
                TextColor="{StaticResource TextWhite}"
                Padding="15,10"
                CornerRadius="8"
                FontSize="{DynamicResource ButtonFontSize}"
                HeightRequest="{DynamicResource ButtonHeight}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="all">
                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryCTA}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Type Filter: User -->
            <Button 
                Grid.Column="1"
                Text="이용자"
                Command="{Binding ApplyFilterCommand}"
                CommandParameter="user"
                BackgroundColor="{StaticResource SurfaceDarkGray}"
                TextColor="{StaticResource TextWhite}"
                Padding="15,10"
                CornerRadius="8"
                FontSize="{DynamicResource ButtonFontSize}"
                HeightRequest="{DynamicResource ButtonHeight}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="user">
                        <Setter Property="BackgroundColor" Value="{StaticResource MarkerUser}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Type Filter: Assistant -->
            <Button 
                Grid.Column="2"
                Text="활동지원사"
                Command="{Binding ApplyFilterCommand}"
                CommandParameter="assistant"
                BackgroundColor="{StaticResource SurfaceDarkGray}"
                TextColor="{StaticResource TextWhite}"
                Padding="15,10"
                CornerRadius="8"
                FontSize="{DynamicResource ButtonFontSize}"
                HeightRequest="{DynamicResource ButtonHeight}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding SelectedTypeFilter}" Value="assistant">
                        <Setter Property="BackgroundColor" Value="{StaticResource MarkerAssistant}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Search Bar -->
            <SearchBar 
                Grid.Column="3"
                Placeholder="이름 또는 주소로 검색..."
                Text="{Binding SearchText}"
                BackgroundColor="{StaticResource SurfaceDarkGray}"
                TextColor="{StaticResource TextWhite}"
                PlaceholderColor="{StaticResource TextLightGray}"
                SearchCommand="{Binding ApplyFilterCommand}" />

            <!-- Reload Button -->
            <Button 
                Grid.Column="4"
                Text="🔄"
                Command="{Binding LoadDataCommand}"
                BackgroundColor="{StaticResource AccentSecondary}"
                TextColor="{StaticResource TextWhite}"
                Padding="15,10"
                CornerRadius="8"
                WidthRequest="50"
                FontSize="{DynamicResource ButtonFontSize}"
                HeightRequest="{DynamicResource ButtonHeight}" />
        </Grid>

        <!-- Content: DataGrid -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource SurfaceDarkGray}" Padding="15" RowDefinitions="Auto,*,Auto">
            
            <!-- Column Headers -->
            <Grid Grid.Row="0" ColumnDefinitions="40,50,*,100,150,120,80" Padding="10" BackgroundColor="{StaticResource SurfaceDarkNavy}">
                <Label Grid.Column="0" Text="" />
                <Label Grid.Column="1" Text="ID" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource PrimaryCTA}" />
                <Label Grid.Column="2" Text="이름" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource PrimaryCTA}" />
                <Label Grid.Column="3" Text="유형" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource PrimaryCTA}" />
                <Label Grid.Column="4" Text="주소" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource PrimaryCTA}" />
                <Label Grid.Column="5" Text="전화번호" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource PrimaryCTA}" />
                <Label Grid.Column="6" Text="경력" Style="{StaticResource Caption}" FontAttributes="Bold" TextColor="{StaticResource PrimaryCTA}" />
            </Grid>

            <!-- Data Rows -->
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding FilteredPersons}"
                            Margin="0,10,0,0"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SelectablePerson">
                        <Border Padding="10"
                                Margin="0,4"
                                BackgroundColor="{StaticResource BackgroundDeepNavy}"
                                Stroke="{StaticResource TextTertiary}"
                                StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Stroke" Value="{StaticResource PrimaryCTA}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                    <!-- Slight tint highlight -->
                                    <Setter Property="BackgroundColor" Value="#142DD4BF" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManagementViewModel}}, Path=SelectRowCommand}" CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="48,50,*,100,150,120,80" ColumnSpacing="8" VerticalOptions="Center">
                                <!-- Checkbox with border highlight -->
                                <Border Grid.Column="0"
                                        Padding="4"
                                        Stroke="Transparent"
                                        StrokeThickness="2"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Stroke" Value="{StaticResource PrimaryCTA}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ManagementViewModel}}, Path=ToggleSelectionCommand}" CommandParameter="{Binding}" />
                                    </Border.GestureRecognizers>

                                    <CheckBox x:Name="SelectionCheck"
                                              HorizontalOptions="Center"
                                              VerticalOptions="Center"
                                              Scale="1.1"
                                              InputTransparent="True"
                                              IsChecked="{Binding IsSelected}" />
                                </Border>

                                <Label Grid.Column="1" Text="{Binding Id}" Style="{StaticResource Body2}" TextColor="{StaticResource TextLightGray}" />
                                <Label Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Body1}" TextColor="{StaticResource TextWhite}" FontAttributes="Bold" />
                                <Label Grid.Column="3" Text="{Binding Type, Converter={StaticResource PersonTypeToKoreanConverter}}" Style="{StaticResource Body2}" TextColor="{StaticResource PrimaryCTA}" />
                                <Label Grid.Column="4" Text="{Binding Address}" Style="{StaticResource Caption}" TextColor="{StaticResource TextLightGray}" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="5" Text="{Binding Phone}" Style="{StaticResource Caption}" TextColor="{StaticResource TextLightGray}" />
                                <Label Grid.Column="6" Text="{Binding ExperienceYears, StringFormat='{0}년'}" Style="{StaticResource Caption}" TextColor="{StaticResource TextLightGray}" IsVisible="{Binding ExperienceYears, Converter={StaticResource IsNotNullConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label 
                        Text="데이터가 없습니다. '🔄' 버튼을 눌러 데이터를 로드하세요."
                        Style="{StaticResource Body1}"
                        TextColor="{StaticResource TextLightGray}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="20" />
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- Footer Actions -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" Margin="0,10,0,0">
                <Label 
                    Grid.Column="0"
                    Text="{Binding FilteredPersons.Count, StringFormat='총 {0}명'}"
                    Style="{StaticResource Body2}"
                    TextColor="{StaticResource TextLightGray}"
                    VerticalOptions="Center" />

                <Button Grid.Column="1"
                        Text="편집"
                        Command="{Binding EditPersonCommand}"
                        IsEnabled="{Binding HasSingleSelection}"
                        Padding="16,10"
                        CornerRadius="8"
                        FontSize="{DynamicResource ButtonFontSize}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BackgroundColor" Value="{StaticResource AccentSecondary}" />
                            <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                            <Style.Triggers>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDarkGray}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2"
                        Text="삭제"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Padding="16,10"
                        CornerRadius="8"
                        FontSize="{DynamicResource ButtonFontSize}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BackgroundColor" Value="#DC2626" />
                            <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                            <Style.Triggers>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDarkGray}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="3"
                        Text="일괄 삭제"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding HasSelection}"
                        Padding="16,10"
                        CornerRadius="8"
                        FontSize="{DynamicResource ButtonFontSize}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="BackgroundColor" Value="#B91C1C" />
                            <Setter Property="TextColor" Value="{StaticResource TextWhite}" />
                            <Style.Triggers>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDarkGray}" />
                                    <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

        </Grid>

        </Grid>
    </Grid>

</ContentPage>


