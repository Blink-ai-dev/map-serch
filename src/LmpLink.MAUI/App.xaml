<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LmpLink.MAUI"
             xmlns:converters="clr-namespace:LmpLink.MAUI.Converters"
             x:Class="LmpLink.MAUI.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/UiScale.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Dynamic UI Resources (Updated by App.cs) -->
            <x:Double x:Key="InfoOverlayScale">1.0</x:Double>
            <x:Double x:Key="TooltipScale">1.0</x:Double>
            <x:Double x:Key="DetailPanelScale">1.0</x:Double>

            <!-- Converters -->
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
            <converters:CenterModeToColorConverter x:Key="CenterModeToColorConverter" />
            <converters:CenterModeToKoreanConverter x:Key="CenterModeToKoreanConverter" />
            <converters:RadiusToColorConverter x:Key="RadiusToColorConverter" />
            <converters:PersonTypeToKoreanConverter x:Key="PersonTypeToKoreanConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

